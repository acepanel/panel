==> caddy.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!

(ace_site_php) {
	log {
		output file {root}/sites/php/log/access.log
		format transform `{request>remote_ip} - {user_id} [{ts}] "{request>method} {request>uri} {request>proto}" {status} {size} "{request>headers>Referer>[0]}" "{request>headers>User-Agent>[0]}"` {
			time_format "02/Jan/2006:15:04:05 -0700"
		}
	}
	root * {root}/sites/php/public
	encode br zstd gzip

	@ace_acme expression `{http.request.orig_uri.path}.startsWith("/.well-known/acme-challenge/")`
	handle @ace_acme {
		rewrite * {http.request.orig_uri.path}
		file_server {
			root /opt/ace/server/caddy/acme
		}
	}

	import {root}/sites/php/config/site/*.conf
	@ace_redirect_0 host old.golden.test
	redir @ace_redirect_0 https://php.golden.test{uri} 301
	@ace_redirect_1 path /old
	redir @ace_redirect_1 /new 302
	handle_errors 404 {
		# ace:redirect 2
		redir * / 308
	}
	@ace_redirect_3 path /docs
	redir @ace_redirect_3 https://docs.golden.test{uri} 308
	@ace_auth_0 {
		path /*
		not path /.well-known/acme-challenge/*
	}
	basic_auth @ace_auth_0 {
		import {root}/sites/php/htpasswd_0.caddy
	}
	@ace_auth_1 path /admin*
	basic_auth @ace_auth_1 {
		import {root}/sites/php/htpasswd_1.caddy
	}

	php_fastcgi unix//tmp/php-cgi-84.sock
	file_server {
		index index.php index.html
	}
}

http://php.golden.test:80,
http://www.php.golden.test:80 {
	@ace_http not path /.well-known/acme-challenge/*
	redir @ace_http https://{host}{uri} 308
	import ace_site_php
}

https://php.golden.test:443,
https://www.php.golden.test:443 {
	tls {root}/cert.pem {root}/key.pem
	header Strict-Transport-Security max-age=31536000
	import ace_site_php
}
