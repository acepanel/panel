==> site/021-stats-log.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
log ace_stat {
	output net unixgram//tmp/ace_stats.sock {
		soft_start
	}
	format append {
		fields {
			site php
		}
	}
}
