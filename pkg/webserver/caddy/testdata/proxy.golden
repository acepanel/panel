==> caddy.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
import {root}/sites/proxy/config/shared/*.conf

(ace_upstream_proxy_backend) {
	# ace:upstream backend
	to 127.0.0.1:3001 127.0.0.1:3002
	lb_policy weighted_round_robin 5 1
}

(ace_upstream_proxy_pool) {
	# ace:upstream pool
	to 10.0.0.2:80 unix//tmp/api.sock
	lb_policy least_conn
}

(ace_site_proxy) {
	log {
		output file {root}/sites/proxy/log/access.log
		format transform `{request>remote_ip} - {user_id} [{ts}] "{request>method} {request>uri} {request>proto}" {status} {size} "{request>headers>Referer>[0]}" "{request>headers>User-Agent>[0]}"` {
			time_format "02/Jan/2006:15:04:05 -0700"
		}
	}
	root * {root}/sites/proxy/public
	encode br zstd gzip

	@ace_acme expression `{http.request.orig_uri.path}.startsWith("/.well-known/acme-challenge/")`
	handle @ace_acme {
		rewrite * {http.request.orig_uri.path}
		file_server {
			root /opt/ace/server/caddy/acme
		}
	}

	import {root}/sites/proxy/config/site/*.conf
	@ace_auth_0 path /secret*
	basic_auth @ace_auth_0 {
		import {root}/sites/proxy/htpasswd_0.caddy
	}

	route {
		@ace_proxy_3 expression `{http.request.orig_uri.path} == "/health"`
		handle @ace_proxy_3 {
			# ace:location = /health
			# ace:pass http://127.0.0.1:9000
			rewrite * {http.request.orig_uri}
			@ace_deny_3 remote_ip 10.0.0.99
			respond @ace_deny_3 403
			@ace_allow_3 not remote_ip 10.0.0.0/8
			respond @ace_allow_3 403
			reverse_proxy 127.0.0.1:9000 {
				header_up X-Real-IP {remote_host}
			}
		}
		@ace_proxy_1 expression `{http.request.orig_uri.path}.startsWith("/api/")`
		handle @ace_proxy_1 {
			# ace:location ^~ /api/
			# ace:pass https://10.0.0.5/v2/
			rewrite * {http.request.orig_uri}
			request_body {
				max_size 10485760
			}
			@ace_allow_1 not remote_ip 10.0.0.0/8 192.168.0.0/16
			respond @ace_allow_1 403
			uri path_regexp ^/api/ /v2/
			reverse_proxy 10.0.0.5:443 {
				header_up Host api.golden.test
				header_up X-Real-IP {remote_host}
				header_down X-Proxy ace
				header_down X-Scheme {scheme}
				header_down -Server
				flush_interval -1
				lb_retries 3
				lb_try_duration 10s
				transport http {
					tls
					tls_server_name api.internal
					tls_trust_pool file {root}/cert.pem
					versions h2c 2
					dial_timeout 5s
					response_header_timeout 1m30s
				}
			}
		}
		@ace_proxy_2 expression `{http.request.orig_uri.path}.matches("(?i)\\.(jpg|png)$")`
		handle @ace_proxy_2 {
			# ace:location ~* \.(jpg|png)$
			# ace:pass http://pool
			rewrite * {http.request.orig_uri}
			request_body {
				max_size 1048576
			}
			reverse_proxy {
				import ace_upstream_proxy_pool
				header_up Host {upstream_hostport}
				header_up X-Real-IP {remote_host}
				header_up X-Static 1
				header_down X-Static 1
			}
		}
		@ace_proxy_5 expression `{http.request.orig_uri.path}.startsWith("/internal")`
		handle @ace_proxy_5 {
			# ace:location /internal
			# ace:pass http://127.0.0.1:9001
			rewrite * {http.request.orig_uri}
			@ace_deny_5 remote_ip 0.0.0.0/0 ::/0
			respond @ace_deny_5 403
			reverse_proxy 127.0.0.1:9001 {
				header_up Host {upstream_hostport}
				header_up X-Real-IP {remote_host}
				flush_interval -1
			}
			# ace:custom
			header X-Custom value
			# 注释保留
		}
		@ace_proxy_4 expression `{http.request.orig_uri.path}.startsWith("/ws")`
		handle @ace_proxy_4 {
			# ace:location /ws
			# ace:pass https://backend.golden.test
			rewrite * {http.request.orig_uri}
			@ace_deny_4 remote_ip 10.0.0.99
			respond @ace_deny_4 403
			reverse_proxy backend.golden.test:443 {
				header_up Host {upstream_hostport}
				header_up X-Real-IP {remote_host}
				flush_interval -1
				transport http {
					tls
					tls_insecure_skip_verify
				}
			}
		}
		@ace_proxy_0 expression `{http.request.orig_uri.path}.startsWith("/")`
		handle @ace_proxy_0 {
			# ace:location /
			# ace:pass http://backend
			rewrite * {http.request.orig_uri}
			replace http://old https://new
			reverse_proxy {
				import ace_upstream_proxy_backend
				header_up Host {upstream_hostport}
				header_up X-Real-IP {remote_host}
				header_up X-Forwarded-Host {host}
				header_up X-Forwarded-Proto https
				header_up X-Request-Start t=$msec
			}
		}
	}

	file_server {
		index index.html
	}
}

http://proxy.golden.test:80 {
	import ace_site_proxy
}

https://proxy.golden.test:8443 {
	tls {root}/cert.pem {root}/key.pem {
		protocols tls1.3
	}
	import ace_site_proxy
}
