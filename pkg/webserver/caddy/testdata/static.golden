==> caddy.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!

(ace_site_static) {
	log {
		output file {root}/sites/static/log/access.log
		format transform `{request>remote_ip} - {user_id} [{ts}] "{request>method} {request>uri} {request>proto}" {status} {size} "{request>headers>Referer>[0]}" "{request>headers>User-Agent>[0]}"` {
			time_format "02/Jan/2006:15:04:05 -0700"
		}
	}
	root * {root}/sites/static/public
	encode br zstd gzip

	@ace_acme expression `{http.request.orig_uri.path}.startsWith("/.well-known/acme-challenge/")`
	handle @ace_acme {
		rewrite * {http.request.orig_uri.path}
		file_server {
			root /opt/ace/server/caddy/acme
		}
	}

	import {root}/sites/static/config/site/*.conf
	@ace_redirect_0 path /old
	redir @ace_redirect_0 /new 302
	@ace_auth_0 path /private*
	basic_auth @ace_auth_0 {
		import {root}/sites/static/htpasswd_0.caddy
	}

	route {
		@ace_proxy_0 expression `{http.request.orig_uri.path}.startsWith("/api")`
		handle @ace_proxy_0 {
			# ace:location ^~ /api
			# ace:pass http://127.0.0.1:3000
			rewrite * {http.request.orig_uri}
			reverse_proxy 127.0.0.1:3000 {
				header_up X-Real-IP {remote_host}
			}
		}
	}

	file_server {
		index index.html index.htm
	}
}

(ace_site_static_stop) {
	log {
		output file {root}/sites/static/log/access.log
		format transform `{request>remote_ip} - {user_id} [{ts}] "{request>method} {request>uri} {request>proto}" {status} {size} "{request>headers>Referer>[0]}" "{request>headers>User-Agent>[0]}"` {
			time_format "02/Jan/2006:15:04:05 -0700"
		}
	}
	root * {root}/sites/static/public
	encode br zstd gzip

	@ace_acme expression `{http.request.orig_uri.path}.startsWith("/.well-known/acme-challenge/")`
	handle @ace_acme {
		rewrite * {http.request.orig_uri.path}
		file_server {
			root /opt/ace/server/caddy/acme
		}
	}
	# ace:stop
	@ace_stop expression true
	handle @ace_stop {
		rewrite * /stop.html
		file_server {
			root /opt/ace/server/caddy/html
		}
	}
}

http://static.golden.test:80 {
	bind 127.0.0.1
	import ace_site_static_stop
}

https://static.golden.test:443 {
	bind 127.0.0.1
	tls {root}/cert.pem {root}/key.pem
	import ace_site_static_stop
}
