==> apache.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
IncludeOptional /opt/ace/sites/static/config/shared/*.conf
<VirtualHost 127.0.0.1:443>
    ServerName static.golden.test
    DocumentRoot {root}/sites/static/public
    DirectoryIndex index.html index.htm
    SSLEngine on
    SSLCertificateFile {root}/cert.pem
    SSLCertificateKeyFile {root}/key.pem
    SSLProtocol -all +TLSv1.2 +TLSv1.3
    # custom configs
    IncludeOptional /opt/ace/sites/static/config/site/*.conf
    <Directory {root}/sites/static/public>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
    <Location /private>
        Require valid-user
        AuthType Basic
        AuthName Restricted
        AuthUserFile {root}/sites/static/htpasswd_0.apache
    </Location>
</VirtualHost>

<VirtualHost 127.0.0.1:80>
    ServerName static.golden.test
    DocumentRoot {root}/sites/static/public
    DirectoryIndex index.html index.htm
    # custom configs
    IncludeOptional /opt/ace/sites/static/config/site/*.conf
    <Directory {root}/sites/static/public>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
    <Location /private>
        Require valid-user
        AuthType Basic
        AuthName Restricted
        AuthUserFile {root}/sites/static/htpasswd_0.apache
    </Location>
</VirtualHost>
