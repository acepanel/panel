==> site/200-proxy.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
<IfModule mod_proxy.c>
    ProxyPassMatch ^/\.well-known/acme-challenge/ !
    <If "%{REQUEST_URI} =~ m#^/\.well-known/acme-challenge/#">
    </If>
</IfModule>
# Reverse proxy: = /health -> http://127.0.0.1:9000
<IfModule mod_proxy.c>
    # ace:proxy 3
    # ace:location = /health
    # ace:pass http://127.0.0.1:9000
    ProxyPassMatch ^/health$ http://127.0.0.1:9000 upgrade=websocket
    ProxyPassReverse / http://127.0.0.1:9000/
    <ElseIf "%{REQUEST_URI} =~ m#^/health$#">
        RequestHeader set X-Real-IP expr=%{REMOTE_ADDR}
        RequestHeader set X-Forwarded-Proto expr=%{REQUEST_SCHEME}
        ProxyPreserveHost On
        AuthMerging And
        <RequireAll>
            Require ip 10.0.0.0/8
            Require not ip 10.0.0.99
        </RequireAll>
    </ElseIf>
</IfModule>
# Reverse proxy: ^~ /api/ -> https://10.0.0.5/v2/
<IfModule mod_proxy.c>
    # ace:proxy 1
    # ace:location ^~ /api/
    # ace:pass https://10.0.0.5/v2/
    ProxyPassMatch ^/api/(.*)$ https://10.0.0.5/v2/$1 connectiontimeout=5 timeout=90 flushpackets=on upgrade=websocket
    ProxyPassReverse /api/ https://10.0.0.5/v2/
    <Proxy https://10.0.0.5/v2/>
        ProxySet connectiontimeout=5 timeout=90 flushpackets=on upgrade=websocket
    </Proxy>
    <Proxy https://10.0.0.5/>
        SSLProxyEngine On
        SSLProxyVerify require
        SSLProxyVerifyDepth 2
        SSLProxyCACertificateFile {root}/cert.pem
    </Proxy>
    <ElseIf "%{REQUEST_URI} =~ m#^/api/(.*)$#">
        RequestHeader set X-Real-IP expr=%{REMOTE_ADDR}
        RequestHeader set X-Forwarded-Proto expr=%{REQUEST_SCHEME}
        ProxyPreserveHost On
        RequestHeader set Host api.golden.test
        AuthMerging And
        Require ip 10.0.0.0/8 192.168.0.0/16
        Header unset Server
        Header set X-Proxy ace
        Header set X-Scheme expr=%{REQUEST_SCHEME}
        <If "%{HTTP:Content-Length} -gt 10485760">
            Redirect 413
        </If>
        <ElseIf "-n %{HTTP:Transfer-Encoding}">
            Redirect 411
        </ElseIf>
    </ElseIf>
</IfModule>
# Reverse proxy: ~* \.(jpg|png)$ -> http://pool
<IfModule mod_proxy.c>
    # ace:proxy 2
    # ace:location ~* \.(jpg|png)$
    # ace:pass http://pool
    ProxyPassMatch (?i)\.(jpg|png)$ balancer://pool
    ProxyPassReverse / balancer://pool/
    <ElseIf "%{REQUEST_URI} =~ m#(?i)\.(jpg|png)$#">
        RequestHeader set X-Real-IP expr=%{REMOTE_ADDR}
        RequestHeader set X-Forwarded-Proto expr=%{REQUEST_SCHEME}
        RequestHeader set X-Static 1
        Header set X-Static 1
        <If "%{HTTP:Content-Length} -gt 1048576">
            Redirect 413
        </If>
        <ElseIf "-n %{HTTP:Transfer-Encoding}">
            Redirect 411
        </ElseIf>
    </ElseIf>
</IfModule>
# Reverse proxy: /internal -> http://127.0.0.1:9001
<IfModule mod_proxy.c>
    # ace:proxy 5
    # ace:location /internal
    # ace:pass http://127.0.0.1:9001
    ProxyPassMatch ^/internal http://127.0.0.1:9001 flushpackets=on upgrade=websocket
    ProxyPassReverse / http://127.0.0.1:9001/
    <ElseIf "%{REQUEST_URI} =~ m#^/internal#">
        RequestHeader set X-Real-IP expr=%{REMOTE_ADDR}
        RequestHeader set X-Forwarded-Proto expr=%{REQUEST_SCHEME}
        AuthMerging And
        Require all denied
        # ace:custom
        Header always set X-Custom value
        # 注释保留
    </ElseIf>
</IfModule>
# Reverse proxy: /ws -> https://backend.golden.test
<IfModule mod_proxy.c>
    # ace:proxy 4
    # ace:location /ws
    # ace:pass https://backend.golden.test
    ProxyPassMatch ^/ws https://backend.golden.test flushpackets=on upgrade=websocket
    ProxyPassReverse / https://backend.golden.test/
    <Proxy https://backend.golden.test/>
        SSLProxyEngine On
        SSLProxyVerify none
        SSLProxyCheckPeerCN off
        SSLProxyCheckPeerName off
    </Proxy>
    <ElseIf "%{REQUEST_URI} =~ m#^/ws#">
        RequestHeader set X-Real-IP expr=%{REMOTE_ADDR}
        RequestHeader set X-Forwarded-Proto expr=%{REQUEST_SCHEME}
        AuthMerging And
        <RequireAll>
            Require all granted
            Require not ip 10.0.0.99
        </RequireAll>
    </ElseIf>
</IfModule>
# Reverse proxy: / -> http://backend
<IfModule mod_proxy.c>
    # ace:proxy 0
    # ace:location /
    # ace:pass http://backend
    ProxyPassMatch ^/ balancer://backend
    ProxyPassReverse / balancer://backend/
    <LocationMatch ^(?!/\.well-known/acme-challenge/)(?!/health$)(?!/api/)(?!.*(?:(?i)\.(jpg|png)$))(?!/internal)(?!/ws)(?=/)>
        CacheEnable disk
        CacheIgnoreNoLastMod On
        CacheStaleOnError Off
        Header merge Cache-Control private "expr=-n %{resp:Set-Cookie}"
        CacheDefaultExpire 600
        CacheMinExpire 600
        CacheMaxExpire 600
    </LocationMatch>
    <ElseIf "%{REQUEST_URI} =~ m#^/#">
        RequestHeader set X-Real-IP expr=%{REMOTE_ADDR}
        RequestHeader set X-Forwarded-Proto https
        RequestHeader set X-Forwarded-Host expr=%{HTTP_HOST}
        RequestHeader set X-Request-Start t=$msec
        <IfModule mod_substitute.c>
            RequestHeader unset Accept-Encoding
            AddOutputFilterByType SUBSTITUTE text/html text/plain text/xml
            Substitute "s|http://old|https://new|n"
        </IfModule>
    </ElseIf>
</IfModule>
