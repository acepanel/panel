==> apache.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
IncludeOptional /opt/ace/sites/proxy/config/shared/*.conf
<VirtualHost *:8443>
    ServerName proxy.golden.test
    DocumentRoot {root}/sites/proxy/public
    DirectoryIndex index.html
    SSLEngine on
    SSLCertificateFile {root}/cert.pem
    SSLCertificateKeyFile {root}/key.pem
    SSLProtocol -all +TLSv1.3
    # custom configs
    IncludeOptional /opt/ace/sites/proxy/config/site/*.conf
    <Directory {root}/sites/proxy/public>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
    <Location /secret>
        Require valid-user
        AuthType Basic
        AuthName Restricted
        AuthUserFile {root}/sites/proxy/htpasswd_0.apache
    </Location>
</VirtualHost>

<VirtualHost *:80>
    ServerName proxy.golden.test
    DocumentRoot {root}/sites/proxy/public
    DirectoryIndex index.html
    # custom configs
    IncludeOptional /opt/ace/sites/proxy/config/site/*.conf
    <Directory {root}/sites/proxy/public>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
    <Location /secret>
        Require valid-user
        AuthType Basic
        AuthName Restricted
        AuthUserFile {root}/sites/proxy/htpasswd_0.apache
    </Location>
</VirtualHost>
==> shared/100-balancer-backend.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
# Load balancer: backend
<IfModule mod_proxy_balancer.c>
    <Proxy balancer://backend>
        BalancerMember http://127.0.0.1:3001 upgrade=websocket loadfactor=5
        BalancerMember http://127.0.0.1:3002 upgrade=websocket
        ProxySet lbmethod=byrequests
    </Proxy>
</IfModule>
==> shared/101-balancer-pool.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
# Load balancer: pool
<IfModule mod_proxy_balancer.c>
    <Proxy balancer://pool>
        BalancerMember http://10.0.0.2:80 upgrade=websocket status=+H
        BalancerMember unix:/tmp/api.sock|http://uds-83e5cd3e upgrade=websocket
        ProxySet lbmethod=bybusyness
    </Proxy>
</IfModule>
