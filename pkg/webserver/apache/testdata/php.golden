==> apache.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
IncludeOptional /opt/ace/sites/php/config/shared/*.conf
<VirtualHost *:443>
    ServerName php.golden.test
    ServerAlias www.php.golden.test
    DocumentRoot {root}/sites/php/public
    DirectoryIndex index.php index.html
    SSLEngine on
    SSLCertificateFile {root}/cert.pem
    SSLCertificateKeyFile {root}/key.pem
    SSLProtocol -all +TLSv1.2 +TLSv1.3
    SSLUseStapling on
    Header always set Strict-Transport-Security max-age=31536000
    SetEnv rate-limit 512
    SetOutputFilter RATE_LIMIT
    RewriteEngine on
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=308,L]
    RemoteIPHeader X-Forwarded-For
    RemoteIPTrustedProxy 10.0.0.0/8
    RemoteIPTrustedProxy 192.168.1.1
    # custom configs
    IncludeOptional /opt/ace/sites/php/config/site/*.conf
    <Directory {root}/sites/php/public>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
    <LocationMatch ^/(?!\.well-known/acme-challenge/)>
        Require valid-user
        AuthType Basic
        AuthName Restricted
        AuthUserFile {root}/sites/php/htpasswd_0.apache
    </LocationMatch>
    <Location /admin>
        Require valid-user
        AuthType Basic
        AuthName Restricted
        AuthUserFile {root}/sites/php/htpasswd_1.apache
    </Location>
</VirtualHost>

<VirtualHost *:80>
    ServerName php.golden.test
    ServerAlias www.php.golden.test
    DocumentRoot {root}/sites/php/public
    DirectoryIndex index.php index.html
    SetEnv rate-limit 512
    SetOutputFilter RATE_LIMIT
    RewriteEngine on
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=308,L]
    RemoteIPHeader X-Forwarded-For
    RemoteIPTrustedProxy 10.0.0.0/8
    RemoteIPTrustedProxy 192.168.1.1
    # custom configs
    IncludeOptional /opt/ace/sites/php/config/site/*.conf
    <Directory {root}/sites/php/public>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
    <LocationMatch ^/(?!\.well-known/acme-challenge/)>
        Require valid-user
        AuthType Basic
        AuthName Restricted
        AuthUserFile {root}/sites/php/htpasswd_0.apache
    </LocationMatch>
    <Location /admin>
        Require valid-user
        AuthType Basic
        AuthName Restricted
        AuthUserFile {root}/sites/php/htpasswd_1.apache
    </Location>
</VirtualHost>
