==> openlitespeed.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
docRoot                  {root}/sites/static/public

index {
  useServer                0
  indexFiles               index.html, index.htm
}

errorlog {root}/sites/static/log/error.log {
  useServer                0
  logLevel                 WARN
  rollingSize              10M
}

accesslog {root}/sites/static/log/access.log {
  useServer                0
  logFormat                %h %l %u %t "%r" %>s %b "%{Referer}i" "%{User-Agent}i"
  rollingSize              10M
  keepDays                 30
}

vhssl {
  keyFile                  {root}/key.pem
  certFile                 {root}/cert.pem
  certChain                1
  sslProtocol              24
  sslSessionCache          1
  enableQuic               1
}

realm static_auth_0 {
  userDB {
    location                 {root}/sites/static/htpasswd_0
    maxCacheSize             200
    cacheTimeout             60
  }
}

extprocessor static_proxy_0 {
  type                     proxy
  address                  127.0.0.1:3000
  maxConns                 100
  initTimeout              60
  retryTimeout             0
  persistConn              1
  pcKeepAliveTimeout       60
  respBuffer               1
}

context /api/ {
  type                     proxy
  handler                  static_proxy_0
  # ace:location ^~ /api
  # ace:pass http://127.0.0.1:3000
}

websocket /api/ {
  address                  127.0.0.1:3000
}

context / {
  location                 $DOC_ROOT/
  allowBrowse              1
  rewrite {
    enable                   1
  }
}

context /private/ {
  location                 $DOC_ROOT/private/
  allowBrowse              1
  realm                    static_auth_0
  # ace:auth /private
}

context /ace-stop/ {
  location                 /opt/ace/server/openlitespeed/html/
  allowBrowse              1
}
include                  {root}/sites/static/config/site/010-error-404.conf

rewrite {
  enable                   1
  autoLoadHtaccess         1
  RewriteCond              %{REQUEST_URI} !^/ace-stop/
  RewriteRule              ^ /ace-stop/stop.html [L]
  # ace:redirect 0
  RewriteRule              ^/old$ /new [R=302,L,QSD]
  RewriteRule              ^/api/ - [L]
  include                  {root}/sites/static/config/site/800-spa.conf
}
==> openlitespeed.listen.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
listen                   127.0.0.1:80
listen                   127.0.0.1:443 ssl quic
domain                   static.golden.test
