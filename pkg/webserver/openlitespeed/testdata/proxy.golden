==> openlitespeed.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
docRoot                  {root}/sites/proxy/public

index {
  useServer                0
  indexFiles               index.html
}

errorlog {root}/sites/proxy/log/error.log {
  useServer                0
  logLevel                 WARN
  rollingSize              10M
}

accesslog {root}/sites/proxy/log/access.log {
  useServer                0
  logFormat                %h %l %u %t "%r" %>s %b "%{Referer}i" "%{User-Agent}i"
  rollingSize              10M
  keepDays                 30
}

vhssl {
  keyFile                  {root}/key.pem
  certFile                 {root}/cert.pem
  certChain                1
  sslProtocol              16
  sslSessionCache          1
  enableQuic               1
}

realm proxy_auth_0 {
  userDB {
    location                 {root}/sites/proxy/htpasswd_0
    maxCacheSize             200
    cacheTimeout             60
  }
}

extprocessor proxy_up_backend_0 {
  type                     proxy
  address                  127.0.0.1:3001
  maxConns                 100
  initTimeout              60
  retryTimeout             0
  persistConn              1
  pcKeepAliveTimeout       60
  respBuffer               0
}

extprocessor proxy_up_backend_1 {
  type                     proxy
  address                  127.0.0.1:3002
  maxConns                 100
  initTimeout              60
  retryTimeout             0
  persistConn              1
  pcKeepAliveTimeout       60
  respBuffer               0
}

extprocessor proxy_up_backend {
  type                     loadbalancer
  workers                  proxy::proxy_up_backend_0, proxy::proxy_up_backend_1
}

extprocessor proxy_up_pool_0 {
  type                     proxy
  address                  10.0.0.2:80
  maxConns                 100
  initTimeout              60
  retryTimeout             0
  persistConn              1
  pcKeepAliveTimeout       60
  respBuffer               0
}

extprocessor proxy_up_pool_1 {
  type                     proxy
  address                  uds://tmp/api.sock
  maxConns                 100
  initTimeout              60
  retryTimeout             0
  persistConn              1
  pcKeepAliveTimeout       60
  respBuffer               0
}

extprocessor proxy_up_pool {
  type                     loadbalancer
  workers                  proxy::proxy_up_pool_0, proxy::proxy_up_pool_1
}

context / {
  type                     loadbalancer
  handler                  proxy_up_backend
  # ace:location /
  # ace:pass http://backend
}

extprocessor proxy_proxy_1 {
  type                     proxy
  address                  https://10.0.0.5:443
  maxConns                 100
  initTimeout              60
  retryTimeout             0
  persistConn              1
  pcKeepAliveTimeout       60
  respBuffer               0
}

context /api/ {
  location                 $DOC_ROOT/
  allowBrowse              0
  rewrite {
    enable                   1
    RewriteRule              ^(.*)$ https://proxy_proxy_1/v2/$1 [P,L,NE,E=Proxy-Host:api.golden.test]
  }
  extraHeaders <<<END_extraHeaders
Header set X-Proxy ace
Header unset Server
END_extraHeaders
  accessControl {
    allow                    10.0.0.0/8, 192.168.0.0/16
    deny                     ALL
  }
  # ace:location ^~ /api/
  # ace:pass https://10.0.0.5/v2/
}

context exp:(?i)\.(jpg|png)$ {
  type                     loadbalancer
  handler                  proxy_up_pool
  extraHeaders <<<END_extraHeaders
Header set X-Static 1
END_extraHeaders
  # ace:location ~* \.(jpg|png)$
  # ace:pass http://pool
}

extprocessor proxy_proxy_3 {
  type                     proxy
  address                  127.0.0.1:9000
  maxConns                 100
  initTimeout              60
  retryTimeout             0
  persistConn              1
  pcKeepAliveTimeout       60
  respBuffer               1
}

context exp:^/health$ {
  type                     proxy
  handler                  proxy_proxy_3
  accessControl {
    allow                    10.0.0.0/8
    deny                     10.0.0.99, ALL
  }
  # ace:location = /health
  # ace:pass http://127.0.0.1:9000
}

extprocessor proxy_proxy_4 {
  type                     proxy
  address                  https://backend.golden.test:443
  maxConns                 100
  initTimeout              60
  retryTimeout             0
  persistConn              1
  pcKeepAliveTimeout       60
  respBuffer               0
}

context /ws/ {
  location                 $DOC_ROOT/
  allowBrowse              0
  rewrite {
    enable                   1
    RewriteRule              ^ https://proxy_proxy_4%{ORG_REQ_URI} [P,L,NE,E=Proxy-Host:backend.golden.test]
  }
  accessControl {
    deny                     10.0.0.99
  }
  # ace:location /ws
  # ace:pass https://backend.golden.test
}

extprocessor proxy_proxy_5 {
  type                     proxy
  address                  127.0.0.1:9001
  maxConns                 100
  initTimeout              60
  retryTimeout             0
  persistConn              1
  pcKeepAliveTimeout       60
  respBuffer               0
}

context /internal/ {
  location                 $DOC_ROOT/
  allowBrowse              0
  rewrite {
    enable                   1
    RewriteRule              ^ http://proxy_proxy_5%{ORG_REQ_URI} [P,L,NE,E=Proxy-Host:127.0.0.1:9001]
  }
  accessControl {
    deny                     ALL
  }
  # ace:location /internal
  # ace:pass http://127.0.0.1:9001
  # ace:custom
  addDefaultCharset        off
  # 注释保留
}

websocket /internal/ {
  address                  127.0.0.1:9001
}

context /secret/ {
  type                     loadbalancer
  handler                  proxy_up_backend
  realm                    proxy_auth_0
  # ace:auth /secret
}
include                  {root}/sites/proxy/config/site/010-error-404.conf

rewrite {
  enable                   1
  autoLoadHtaccess         1
  RewriteRule              ^/api/ - [L]
  RewriteRule              (?i)\.(jpg|png)$ - [L]
  RewriteRule              ^/health$ - [L]
  RewriteRule              ^/ws/ - [L]
  RewriteRule              ^/internal/ - [L]
}
==> openlitespeed.listen.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
listen                   80
listen                   8443 ssl quic
domain                   proxy.golden.test
