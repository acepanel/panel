==> openlitespeed.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
docRoot                  {root}/sites/php/public

index {
  useServer                0
  indexFiles               index.php, index.html
}

errorlog {root}/sites/php/log/error.log {
  useServer                0
  logLevel                 WARN
  rollingSize              10M
}

accesslog {root}/sites/php/log/access.log {
  useServer                0
  logFormat                %h %l %u %t "%r" %>s %b "%{Referer}i" "%{User-Agent}i"
  rollingSize              10M
  keepDays                 30
}

scripthandler {
  include                  /opt/ace/server/openlitespeed/conf/panel/php/84.conf
}

vhssl {
  keyFile                  {root}/key.pem
  certFile                 {root}/cert.pem
  certChain                1
  sslProtocol              24
  sslSessionCache          1
  enableQuic               1
  enableStapling           1
}

realm php_auth_0 {
  userDB {
    location                 {root}/sites/php/htpasswd_0
    maxCacheSize             200
    cacheTimeout             60
  }
}

realm php_auth_1 {
  userDB {
    location                 {root}/sites/php/htpasswd_1
    maxCacheSize             200
    cacheTimeout             60
  }
}

context / {
  location                 $DOC_ROOT/
  allowBrowse              1
  rewrite {
    enable                   1
  }
  realm                    php_auth_0
  # ace:auth /
  extraHeaders <<<END_extraHeaders
Header set Strict-Transport-Security max-age=31536000
END_extraHeaders
}

context /admin/ {
  location                 $DOC_ROOT/admin/
  allowBrowse              1
  realm                    php_auth_1
  # ace:auth /admin
  extraHeaders <<<END_extraHeaders
Header set Strict-Transport-Security max-age=31536000
END_extraHeaders
}
include                  {root}/sites/php/config/site/010-cache.conf
include                  {root}/sites/php/config/site/010-error-404.conf
include                  {root}/sites/php/config/site/020-lscache.conf

errorpage 404 {
  # ace:redirect 2
  url                      /
}

rewrite {
  enable                   1
  autoLoadHtaccess         1
  RewriteCond              %{HTTPS} !on
  RewriteRule              ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=308,L]
  # ace:redirect 0
  RewriteCond              %{HTTP_HOST} ^old\.golden\.test$ [NC]
  RewriteRule              ^(.*)$ https://php.golden.test$1 [R=301,L]
  # ace:redirect 1
  RewriteRule              ^/old$ /new [R=302,L,QSD]
  # ace:redirect 3
  RewriteRule              ^/docs$ https://docs.golden.test%{REQUEST_URI} [R=308,L]
}
==> openlitespeed.listen.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
listen                   80
listen                   443 ssl quic
domain                   php.golden.test www.php.golden.test
==> site/001-acme.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
==> site/010-cache.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
expires {
  enableExpires           1
  expiresByType           image/*=A2592000,text/css=A21600,application/javascript=A21600,application/x-javascript=A21600,font/*=A21600,application/font-woff=A21600,application/font-woff2=A21600,application/vnd.ms-fontobject=A21600
}
# deny sensitive files
context exp:^/\.(user\.ini|htaccess|git|svn|env) {
  location                $DOC_ROOT/
  allowBrowse             0
}
==> site/010-error-404.conf <==
