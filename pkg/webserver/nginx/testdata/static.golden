==> nginx.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
include /opt/ace/sites/static/config/shared/*.conf;

server {
    listen 127.0.0.1:80;
    listen 127.0.0.1:443 ssl;
    listen 127.0.0.1:443 quic;
    server_name static.golden.test;
    root {root}/sites/static/public;
    index index.html index.htm;
    auth_basic $ace_auth_realm_static;
    auth_basic_user_file $ace_auth_file_static;
    ssl_certificate {root}/cert.pem;
    ssl_certificate_key {root}/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    # custom configs
    include /opt/ace/sites/static/config/site/*.conf;
}
==> shared/011-auth.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
map $uri $ace_auth_realm_static {
    default off;
    ~^/private(/.*)?$ "Restricted";
}

map $uri $ace_auth_file_static {
    default "";
    ~^/private(/.*)?$ "{root}/sites/static/htpasswd_0";
}
==> site/00-disable.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
rewrite ^(?!/\.well-known/acme-challenge/) /stop.html last;
location = /stop.html {
    root /opt/ace/server/nginx/html;
    auth_basic off;
}
