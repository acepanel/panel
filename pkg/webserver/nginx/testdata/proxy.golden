==> nginx.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
include /opt/ace/sites/proxy/config/shared/*.conf;

server {
    listen 80;
    listen 8443 ssl;
    listen 8443 quic;
    server_name proxy.golden.test;
    root {root}/sites/proxy/public;
    index index.html;
    auth_basic $ace_auth_realm_proxy;
    auth_basic_user_file $ace_auth_file_proxy;
    ssl_certificate {root}/cert.pem;
    ssl_certificate_key {root}/key.pem;
    ssl_protocols TLSv1.3;
    # custom configs
    include /opt/ace/sites/proxy/config/site/*.conf;
}
==> shared/011-auth.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
map $uri $ace_auth_realm_proxy {
    default off;
    ~^/secret(/.*)?$ "Restricted";
}

map $uri $ace_auth_file_proxy {
    default "";
    ~^/secret(/.*)?$ "{root}/sites/proxy/htpasswd_0";
}
==> shared/100-backend.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
# Upstream: backend

upstream backend {
    zone backend 512k;
    server 127.0.0.1:3001 weight=5;
    server 127.0.0.1:3002;
    keepalive 32;
}
==> shared/101-pool.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
# Upstream: pool

upstream pool {
    zone pool 512k;
    least_conn;
    resolver 8.8.8.8 ipv6=off;
    resolver_timeout 5s;
    server 10.0.0.2:80 backup;
    server unix:/tmp/api.sock;
}
