==> site/200-proxy.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
# Reverse proxy: / -> http://backend

location / {
    proxy_pass http://backend;
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Early-Data $ssl_early_data;
    proxy_buffering on;
    proxy_cache cache_one;
    proxy_cache_valid 200 302 10m;
    proxy_cache_bypass $cookie_nocache $arg_nocache;
    proxy_no_cache $cookie_nocache $arg_nocache;
    proxy_cache_use_stale error timeout;
    proxy_cache_background_update on;
    proxy_cache_lock on;
    proxy_cache_min_uses 2;
    proxy_cache_methods GET HEAD;
    proxy_cache_key $scheme$host$request_uri;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Request-Start t=$msec;
    proxy_set_header Accept-Encoding "";
    sub_filter_once off;
    sub_filter http://old https://new;
}
==> site/201-proxy.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
# Reverse proxy: ^~ /api/ -> https://10.0.0.5/v2/

location ^~ /api/ {
    allow 10.0.0.0/8;
    allow 192.168.0.0/16;
    deny all;
    client_max_body_size 10m;
    resolver 8.8.8.8;
    resolver_timeout 5s;
    proxy_pass https://10.0.0.5/v2/;
    proxy_http_version 2;
    proxy_set_header Host api.golden.test;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Early-Data $ssl_early_data;
    proxy_ssl_protocols TLSv1.2 TLSv1.3;
    proxy_ssl_session_reuse off;
    proxy_ssl_server_name on;
    proxy_ssl_name api.internal;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 2;
    proxy_ssl_trusted_certificate {root}/cert.pem;
    proxy_connect_timeout 5s;
    proxy_read_timeout 90s;
    proxy_send_timeout 30s;
    proxy_next_upstream error timeout;
    proxy_next_upstream_tries 3;
    proxy_next_upstream_timeout 10s;
    proxy_buffering off;
    proxy_cache off;
    proxy_hide_header Server;
    add_header_inherit merge;
    add_header X-Proxy ace always;
    add_header X-Scheme $scheme always;
}
==> site/202-proxy.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
# Reverse proxy: ~* \.(jpg|png)$ -> http://pool

location ~* "\\.(jpg|png)$" {
    client_max_body_size 1m;
    proxy_pass http://pool;
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Early-Data $ssl_early_data;
    proxy_buffering on;
    proxy_cache off;
    proxy_set_header X-Static 1;
    add_header_inherit merge;
    add_header X-Static 1 always;
}
==> site/203-proxy.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
# Reverse proxy: = /health -> http://127.0.0.1:9000

location = /health {
    deny 10.0.0.99;
    allow 10.0.0.0/8;
    deny all;
    proxy_pass http://127.0.0.1:9000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Early-Data $ssl_early_data;
    proxy_buffering on;
    proxy_cache off;
}
