==> nginx.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
include /opt/ace/sites/php/config/shared/*.conf;

server {
    listen 80;
    listen 443 ssl;
    listen 443 quic;
    server_name php.golden.test www.php.golden.test;
    root {root}/sites/php/public;
    index index.php index.html;
    limit_rate 512k;
    limit_conn perserver 300;
    limit_conn perip 25;
    auth_basic $ace_auth_realm_php;
    auth_basic_user_file $ace_auth_file_php;
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 192.168.1.1;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    ssl_certificate {root}/cert.pem;
    ssl_certificate_key {root}/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_stapling on;
    ssl_stapling_verify on;
    add_header Strict-Transport-Security max-age=31536000;
    add_header Alt-Svc 'h3=":$server_port"; ma=2592000';
    error_page 497 =308 https://$host:$server_port$request_uri;
    # custom configs
    include /opt/ace/sites/php/config/site/*.conf;
    if ($scheme = http) {
        return 308 https://$host$request_uri;
    }
}
==> shared/010-stat-format.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
log_format ace_stat_php escape=json
  '{"site":"php",'
  '"uri":"$request_uri",'
  '"status":$status,'
  '"bytes":$body_bytes_sent,'
  '"ua":"$http_user_agent",'
  '"ip":"$remote_addr",'
  '"host":"$host",'
  '"method":"$request_method",'
  '"referer":"$http_referer",'
  '"xff":"$http_x_forwarded_for",'
  '"rt":$request_time,'
  '"proto":"$server_protocol",'
  '"port":"$remote_port",'
  '"body":"$request_body",'
  '"content_type":"$sent_http_content_type",'
  '"req_length":$request_length,'
  '"https":"$https",'
  '"upstream_time":"$upstream_response_time",'
  '"upstream_status":"$upstream_status"}';
\ No newline at end of file
==> shared/011-auth.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
map $uri $ace_auth_realm_php {
    default "Restricted";
    ~^/admin(/.*)?$ "Restricted";
}

map $uri $ace_auth_file_php {
    default "{root}/sites/php/htpasswd_0";
    ~^/admin(/.*)?$ "{root}/sites/php/htpasswd_1";
}
