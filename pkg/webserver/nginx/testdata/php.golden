==> site/010-php.conf <==
# Auto-generated by AcePanel. DO NOT EDIT MANUALLY!
location ~ \.php$ {
    try_files $uri =404;
    fastcgi_pass unix:/tmp/php-cgi-84.sock;
    fastcgi_index index.php;
    fastcgi_param HTTP_HOST $host;
    include fastcgi.conf;
    include pathinfo.conf;
}
